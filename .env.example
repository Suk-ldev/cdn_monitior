# ---------------------------------------------------------------------------
# 只需配置你实际使用的平台，未配置的平台会在界面上自动置灰。
# ---------------------------------------------------------------------------

# 腾讯云 EdgeOne —— https://console.cloud.tencent.com/cam/capi
EO_SECRET_ID=
EO_SECRET_KEY=
# 可选：跳过 DescribeZones，直接指定站点 ID（逗号分隔）
EO_ZONE_IDS=
# 可选：默认 ap-guangzhou
EO_REGION=

# 阿里云 ESA 边缘安全加速 —— https://ram.console.aliyun.com/manage/ak
# 建议使用只读子账号，授予 AliyunESAReadOnlyAccess
ESA_ACCESS_KEY_ID=
ESA_ACCESS_KEY_SECRET=
# 可选：跳过 ListSites，直接指定站点 ID（逗号分隔）
ESA_SITE_IDS=
# 可选：默认 cn-hangzhou
ESA_REGION=

# Cloudflare —— https://dash.cloudflare.com/profile/api-tokens
# Token 需要 Zone:Read + Zone Analytics:Read
CF_TOKENS=
CF_ZONES=
CF_DOMAINS=

# ---------------------------------------------------------------------------
# 通用
# ---------------------------------------------------------------------------
SITE_NAME=CDN 流量分析看板
# 首选平台：edgeone | esa | cloudflare（不填则取第一个配置完整的平台）
DEFAULT_PLATFORM=
# 服务端缓存秒数，0 表示关闭
CACHE_TTL=60
# 单个上游请求超时秒数
REQUEST_TIMEOUT=20
DEBUG=false
